{
  "name": "oremea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed:works": "tsx prisma/seeds/works/seed-only.ts",
    "db:seed:resonance": "tsx prisma/seeds/run-resonance.ts",
    "db:verify:resonance": "tsx prisma/scripts/verify-resonance-seed.ts",
    "typecheck": "tsc --noEmit",
    "test:compass-descent": "tsx scripts/verify-compass-descent-contract.ts",
    "test:compass-resolution": "tsx scripts/verify-compass-resolution-contract.ts",
    "test:compass-pricing": "tsx scripts/verify-compass-pricing-contract.ts",
    "test:compass-access": "tsx scripts/verify-compass-access-contract.ts",
    "test:compass-archive": "tsx scripts/verify-compass-archive-access-contract.ts",
    "test:whop-webhook": "tsx scripts/verify-whop-webhook-contract.ts",
    "test:compass": "npm run test:compass-descent && npm run test:compass-resolution && npm run test:compass-pricing && npm run test:compass-access && npm run test:compass-archive && npm run test:whop-webhook",
    "test:recognition-pricing": "tsx scripts/verify-recognition-pricing-contract.ts",
    "test:recognition-questions": "tsx scripts/verify-recognition-question-contract.ts",
    "test:commerce-routing": "tsx scripts/verify-commerce-routing-contract.ts",
    "test:public-pricing": "tsx scripts/verify-public-pricing-contract.ts",
    "test:launch": "npm run test:recognition-pricing && npm run test:recognition-questions && npm run test:commerce-routing && npm run test:public-pricing && npm run test:compass"
  },
  "prisma": {
    "schema": "./prisma",
    "seed": "npx tsx prisma/seeds/run-all.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@clerk/nextjs": "^5.1.0",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.10.2",
    "@tanstack/react-query": "^5.36.0",
    "@trpc/client": "^11.0.0-rc.370",
    "@trpc/react-query": "^11.0.0-rc.370",
    "@trpc/server": "^11.0.0-rc.370",
    "ai": "^3.1.0",
    "next": "^14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.3",
    "superjson": "^2.2.1",
    "zod": "^3.23.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.38",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
