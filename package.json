{
  "name": "oremea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed:works": "tsx prisma/seeds/works/seed-only.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "schema": "./prisma",
    "seed": "npx tsx prisma/seeds/run-all.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@clerk/nextjs": "^5.1.0",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.10.2",
    "@tanstack/react-query": "^5.36.0",
    "@trpc/client": "^11.0.0-rc.370",
    "@trpc/react-query": "^11.0.0-rc.370",
    "@trpc/server": "^11.0.0-rc.370",
    "ai": "^3.1.0",
    "next": "^14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.3",
    "superjson": "^2.2.1",
    "zod": "^3.23.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.38",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
