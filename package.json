{
  "name": "oremea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run test:launch",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "node scripts/deploy-migrations.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed:works": "tsx prisma/seeds/works/seed-only.ts",
    "db:seed:resonance": "tsx prisma/seeds/run-resonance.ts",
    "db:verify:resonance": "tsx prisma/scripts/verify-resonance-seed.ts",
    "typecheck": "tsc --noEmit",
    "test:central-pricing": "tsx scripts/verify-central-pricing-contract.ts",
    "test:production-migrations": "tsx scripts/verify-production-migration-contract.ts",
    "test:backend-hygiene": "tsx scripts/verify-backend-launch-hygiene-contract.ts",
    "test:superseded-boundary": "tsx scripts/verify-superseded-boundary.ts",
    "test:works-payfast": "tsx scripts/verify-works-payfast-contract.ts",
    "test:works-release": "tsx scripts/verify-works-release-surface-contract.ts",
    "test:works-capabilities": "tsx scripts/verify-works-provider-capability-contract.ts",
    "test:works-seo": "tsx scripts/verify-works-dawn-seo-contract.ts",
    "test:works-integrity": "tsx scripts/verify-works-integrity-contract.ts && tsx scripts/verify-works-regulated-claims-contract.ts",
    "test:works-legal": "tsx scripts/verify-legal-navigation-contract.ts && tsx scripts/verify-works-legal-compliance-contract.ts",
    "test:compass-descent": "tsx scripts/verify-compass-descent-contract.ts",
    "test:compass-resolution": "tsx scripts/verify-compass-resolution-contract.ts",
    "test:compass-pricing": "tsx scripts/verify-compass-pricing-contract.ts",
    "test:compass-access": "tsx scripts/verify-compass-access-contract.ts",
    "test:compass-archive": "tsx scripts/verify-compass-archive-access-contract.ts",
    "test:compass-daily-goals": "tsx scripts/verify-compass-daily-goals-contract.ts",
    "test:whop-webhook": "tsx scripts/verify-whop-webhook-contract.ts",
    "test:compass": "npm run test:compass-descent && npm run test:compass-resolution && npm run test:compass-pricing && npm run test:compass-access && npm run test:compass-archive && npm run test:compass-daily-goals && npm run test:whop-webhook",
    "test:recognition-pricing": "tsx scripts/verify-recognition-pricing-contract.ts",
    "test:recognition-conversation": "tsx scripts/verify-recognition-conversation-contract.ts && tsx scripts/verify-recognition-ai-envelope-contract.ts && tsx scripts/verify-recognition-privacy-contract.ts && tsx scripts/verify-recognition-natural-question-contract.ts && tsx scripts/verify-recognition-product-identity-contract.ts",
    "test:commerce-routing": "tsx scripts/verify-commerce-routing-contract.ts",
    "test:public-pricing": "tsx scripts/verify-public-pricing-contract.ts",
    "test:current": "tsx scripts/verify-current-invitation-contract.ts",
    "test:launch": "npm run test:central-pricing && npm run test:production-migrations && npm run test:backend-hygiene && npm run test:superseded-boundary && npm run test:works-payfast && npm run test:works-release && npm run test:works-capabilities && npm run test:works-seo && npm run test:works-integrity && npm run test:works-legal && npm run test:recognition-pricing && npm run test:recognition-conversation && npm run test:commerce-routing && npm run test:public-pricing && npm run test:compass && npm run test:current"
  },
  "prisma": {
    "schema": "./prisma",
    "seed": "npx tsx prisma/seeds/run-all.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@clerk/nextjs": "5.7.6",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.10.2",
    "@tanstack/react-query": "^5.36.0",
    "@trpc/client": "^11.0.0-rc.370",
    "@trpc/react-query": "^11.0.0-rc.370",
    "@trpc/server": "^11.0.0-rc.370",
    "ai": "^3.1.0",
    "next": "^14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.3",
    "superjson": "^2.2.1",
    "zod": "^3.23.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.38",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "@clerk/clerk-react": "5.61.6",
    "js-cookie": "3.0.8"
  }
}
