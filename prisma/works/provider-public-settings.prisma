model works_provider_public_settings {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id        String   @unique @db.Uuid
  show_legal_name    Boolean  @default(false)
  show_website       Boolean  @default(true)
  show_email         Boolean  @default(false)
  show_phone         Boolean  @default(false)
  show_description   Boolean  @default(true)
  show_location      Boolean  @default(false)
  show_capacity      Boolean  @default(false)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @updatedAt @db.Timestamptz(6)

  provider works_providers @relation(fields: [provider_id], references: [id], onDelete: Cascade)

  @@index([provider_id])
}