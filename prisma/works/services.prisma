model works_services {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String   @unique
  slug       String   @unique
  sort_order Int      @default(0)
  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  translations     works_service_translations[]
  categories       works_service_categories[]
  offerings        works_offering_services[]
  production_steps works_production_steps[]
  requirements     works_requirements[]

  @@index([active, sort_order])
}

model works_service_translations {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_id  String   @db.Uuid
  locale_id   String   @db.Uuid
  name        String
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  service works_services @relation(fields: [service_id], references: [id], onDelete: Cascade)
  locale  works_locales  @relation(fields: [locale_id], references: [id], onDelete: Cascade)

  @@unique([service_id, locale_id])
  @@index([locale_id])
}

model works_service_categories {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_id  String   @db.Uuid
  category_id String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  service  works_services   @relation(fields: [service_id], references: [id], onDelete: Cascade)
  category works_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([service_id, category_id])
  @@index([service_id])
  @@index([category_id])
}
