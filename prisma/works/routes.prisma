enum WorksRouteStatus {
  VIABLE
  POTENTIAL
  INCOMPLETE
}

model works_route_options {
  id                           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brief_id                     String           @db.Uuid
  path_id                      String           @db.Uuid
  rank                         Int
  status                       WorksRouteStatus
  route_score                  Int              @default(0)
  provider_count               Int              @default(0)
  handoff_count                Int              @default(0)
  assigned_step_count          Int              @default(0)
  unresolved_step_count        Int              @default(0)
  unresolved_requirement_count Int              @default(0)
  algorithm_version            String           @default("v1")
  is_current                   Boolean          @default(true)
  calculated_at                DateTime         @default(now()) @db.Timestamptz(6)
  created_at                   DateTime         @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime         @updatedAt @db.Timestamptz(6)

  brief       works_product_briefs   @relation(fields: [brief_id], references: [id], onDelete: Cascade)
  path        works_production_paths @relation(fields: [path_id], references: [id], onDelete: Cascade)
  assignments works_route_assignments[]

  @@index([brief_id, is_current, rank])
  @@index([brief_id, status])
  @@index([path_id])
  @@index([route_score])
}

model works_route_assignments {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  route_id    String           @db.Uuid
  step_id     String           @db.Uuid
  match_id    String?          @db.Uuid
  offering_id String?          @db.Uuid
  position    Int
  status      WorksMatchStatus @default(UNKNOWN)
  explanation String
  created_at  DateTime         @default(now()) @db.Timestamptz(6)

  route    works_route_options     @relation(fields: [route_id], references: [id], onDelete: Cascade)
  step     works_production_steps  @relation(fields: [step_id], references: [id], onDelete: Cascade)
  match    works_matches?          @relation(fields: [match_id], references: [id], onDelete: SetNull)
  offering works_offerings?        @relation(fields: [offering_id], references: [id], onDelete: SetNull)

  @@unique([route_id, step_id])
  @@index([route_id, position])
  @@index([step_id])
  @@index([match_id])
  @@index([offering_id])
  @@index([status])
}
