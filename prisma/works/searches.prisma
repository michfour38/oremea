enum WorksSearchSessionStatus {
  IN_PROGRESS
  ROUTE_BUILT
  SOURCING_REQUESTED
  COMPLETED
  ABANDONED
}

enum WorksProcurementRequestStatus {
  REQUESTED
  SEARCHING
  PROVIDERS_FOUND
  CONTACTED
  COMPLETED
  CLOSED
}

model works_search_sessions {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  market_id          String                   @db.Uuid
  browser_session_id String?
  answers            Json                     @default("{}")
  current_step       String?
  status             WorksSearchSessionStatus @default(IN_PROGRESS)
  brief_id           String?                  @unique @db.Uuid
  created_at         DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                 @updatedAt @db.Timestamptz(6)
  completed_at       DateTime?                @db.Timestamptz(6)

  market              works_markets               @relation(fields: [market_id], references: [id], onDelete: Cascade)
  brief               works_product_briefs?       @relation(fields: [brief_id], references: [id], onDelete: SetNull)
  procurement_request works_procurement_requests?

  @@index([market_id, status])
  @@index([browser_session_id])
  @@index([updated_at])
}

model works_procurement_requests {
  id                       String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  search_session_id        String                        @unique @db.Uuid
  brief_id                 String                        @unique @db.Uuid
  name                     String
  email                    String
  phone                    String?
  preferred_contact_method String?
  status                   WorksProcurementRequestStatus @default(REQUESTED)
  consented_at             DateTime                      @default(now()) @db.Timestamptz(6)
  created_at               DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                      @updatedAt @db.Timestamptz(6)

  search_session works_search_sessions      @relation(fields: [search_session_id], references: [id], onDelete: Cascade)
  brief          works_product_briefs       @relation(fields: [brief_id], references: [id], onDelete: Cascade)
  outreach       works_provider_outreach[]

  @@index([status])
  @@index([email])
  @@index([created_at])
}
