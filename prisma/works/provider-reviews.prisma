enum WorksProviderReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

model works_provider_reviews {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id         String                    @db.Uuid
  brief_id            String?                   @db.Uuid
  outreach_id         String?                   @unique @db.Uuid
  reviewer_clerk_id   String?
  reviewer_name       String?
  reviewer_company    String?
  public_identity     Boolean                   @default(false)
  rating              Int
  body                String
  verified_brief      Boolean                   @default(false)
  status              WorksProviderReviewStatus @default(PENDING)
  provider_response   String?
  provider_replied_at DateTime?                 @db.Timestamptz(6)
  created_at          DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                  @updatedAt @db.Timestamptz(6)

  provider works_providers         @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  brief    works_product_briefs?   @relation(fields: [brief_id], references: [id], onDelete: SetNull)
  outreach works_provider_outreach? @relation(fields: [outreach_id], references: [id], onDelete: SetNull)

  @@index([provider_id, status, created_at])
  @@index([provider_id, rating])
  @@index([brief_id])
  @@index([reviewer_clerk_id, created_at])
  @@index([verified_brief])
}