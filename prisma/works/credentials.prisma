enum WorksCredentialType {
  QUALIFICATION
  PROFESSIONAL_REGISTRATION
  LICENCE
  ACCREDITATION
  CERTIFICATION
  PROFESSIONAL_MEMBERSHIP
  SHORT_COURSE
  EXPERIENCE_CLAIM
}

enum WorksCredentialAuthorityType {
  QUALIFICATION_AUTHORITY
  PROFESSIONAL_REGULATOR
  LICENSING_AUTHORITY
  ACCREDITATION_BODY
  CERTIFICATION_BODY
  EDUCATION_PROVIDER
  PROFESSIONAL_ASSOCIATION
  INDUSTRY_ASSOCIATION
  OTHER
}

model works_credential_authorities {
  id                       String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                      String                       @unique
  name                     String
  short_name               String?
  authority_type           WorksCredentialAuthorityType
  website                  String?
  verification_url         String?
  verification_method      WorksVerificationMethod      @default(NONE)
  requires_holder_consent  Boolean                      @default(false)
  active                   Boolean                      @default(true)
  created_at               DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                     @updatedAt @db.Timestamptz(6)

  markets           works_credential_authority_markets[]
  credential_claims works_credential_claims[]

  @@index([authority_type])
  @@index([active])
}

model works_credential_authority_markets {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authority_id String   @db.Uuid
  market_id    String   @db.Uuid
  active       Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  authority works_credential_authorities @relation(fields: [authority_id], references: [id], onDelete: Cascade)
  market    works_markets                @relation(fields: [market_id], references: [id], onDelete: Cascade)

  @@unique([authority_id, market_id])
  @@index([market_id])
  @@index([authority_id])
}

model works_credential_claims {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claim_id          String              @unique @db.Uuid
  credential_type   WorksCredentialType
  authority_id      String?             @db.Uuid
  holder_name       String?
  credential_name   String
  credential_number String?
  designation       String?
  field              String?
  scope              String?
  issued_at          DateTime?           @db.Timestamptz(6)
  expires_at         DateTime?           @db.Timestamptz(6)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @updatedAt @db.Timestamptz(6)

  claim     works_claims                 @relation(fields: [claim_id], references: [id], onDelete: Cascade)
  authority works_credential_authorities? @relation(fields: [authority_id], references: [id], onDelete: SetNull)

  @@index([credential_type])
  @@index([authority_id])
  @@index([credential_number])
  @@index([expires_at])
}
