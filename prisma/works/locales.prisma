model works_locales {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  market_id     String   @db.Uuid
  code          String
  language_code String
  region_code   String?
  name          String
  local_name    String
  is_default    Boolean  @default(false)
  active        Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  market                        works_markets                       @relation(fields: [market_id], references: [id], onDelete: Cascade)
  category_translations         works_category_translations[]
  provider_type_translations    works_provider_type_translations[]
  service_translations          works_service_translations[]
  capability_translations       works_capability_translations[]
  packaging_format_translations works_packaging_format_translations[]

  @@unique([market_id, code])
  @@index([market_id])
}
