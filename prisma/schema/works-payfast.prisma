model works_provider_payfast_subscriptions {
  id                        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id               String            @db.Uuid
  plan                      WorksProviderPlan
  merchant_payment_id       String            @unique @db.VarChar(100)
  subscription_token        String?           @unique @db.VarChar(64)
  status                    String            @default("PENDING") @db.VarChar(24)
  amount_cents              Int
  currency                  String            @default("ZAR") @db.VarChar(3)
  recurring_consent_at      DateTime?         @db.Timestamptz(6)
  recurring_consent_version String?           @db.VarChar(40)
  recurring_consent_summary String?
  recurring_consent_user_id String?           @db.VarChar(255)
  started_at                DateTime?         @db.Timestamptz(6)
  cancelled_at              DateTime?         @db.Timestamptz(6)
  last_payment_at           DateTime?         @db.Timestamptz(6)
  created_at                DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                DateTime          @updatedAt @db.Timestamptz(6)
  events                    works_provider_payfast_events[]

  @@index([provider_id, status])
  @@index([plan])
}

model works_provider_payfast_events {
  id                 String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscription_id    String                               @db.Uuid
  event_key           String                               @unique @db.VarChar(64)
  payfast_payment_id String?                              @unique @db.VarChar(100)
  payment_status     String                               @db.VarChar(40)
  amount_cents       Int?
  received_at        DateTime                             @default(now()) @db.Timestamptz(6)
  subscription       works_provider_payfast_subscriptions @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([subscription_id, received_at])
  @@index([payment_status])
}
