# .env.example
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.

# ── Clerk Authentication ───────────────────────────────────────────────────────
# Found in: https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
CLERK_SECRET_KEY=sk_test_your-secret-key-here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/oremea/enter
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/oremea/enter

# ── Database (Railway PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@host:port/dbname
DIRECT_URL=postgresql://postgres:password@host:port/dbname

# ── Anthropic (AI Reflection) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Resend (Email Notifications) ──────────────────────────────────────────────
RESEND_API_KEY=re_your-key-here
RESEND_FROM_EMAIL=hello@yourdomain.com

# ── WORKS ──────────────────────────────────────────────────────────────────────
# Dedicated WORKS production service / subdomain.
WORKS_HOST=works.oremea.com
WORKS_PUBLIC_URL=https://works.oremea.com
WORKS_OUTREACH_FROM="WORKS <hello@yourdomain.com>"

# WORKS provider billing through PayFast. Keep merchant credentials and the
# passphrase server-side in Railway; never expose them through NEXT_PUBLIC_*.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# ── Whop Checkout ──────────────────────────────────────────────────────────────
# All product prices are canonical in src/lib/oremea/pricing.ts.
RECOGNITION_SUBSCRIPTION_CHECKOUT_URL=

# Compass is one Whop product with two pricing plans: a one-time 30-day pass and
# a recurring monthly membership. Each plan keeps its own direct checkout URL.
COMPASS_CHECKOUT_URL=
COMPASS_SUBSCRIPTION_CHECKOUT_URL=
OREMEA_ALL_ACCESS_CHECKOUT_URL=

# Resonance uses one Whop checkout/product per seven-day room so a successful
# payment can open exactly the room the buyer selected.
RESONANCE_WEEK_1_CHECKOUT_URL=
RESONANCE_WEEK_2_CHECKOUT_URL=
RESONANCE_WEEK_3_CHECKOUT_URL=
RESONANCE_WEEK_4_CHECKOUT_URL=
RESONANCE_WEEK_5_CHECKOUT_URL=
RESONANCE_WEEK_6_CHECKOUT_URL=
RESONANCE_WEEK_7_CHECKOUT_URL=
RESONANCE_WEEK_8_CHECKOUT_URL=
RESONANCE_WEEK_9_CHECKOUT_URL=
RESONANCE_WEEK_10_CHECKOUT_URL=

# The Current is invitation-only. Qualified members queue while the space is
# forming. The first cohort is invited together once the threshold is reached;
# after launch, later qualified members are invited individually.
CURRENT_CHECKOUT_URL=
CURRENT_ACCESS_URL=
CURRENT_LAUNCH_THRESHOLD=50
CURRENT_RECOGNITION_QUALIFY_AFTER_USER_TURNS=7

# Webhook verification + fulfillment IDs.
WHOP_WEBHOOK_SECRET=
WHOP_RECOGNITION_SUBSCRIPTION_PRODUCT_ID=
WHOP_COMPASS_PRODUCT_ID=
WHOP_COMPASS_PASS_PLAN_ID=
WHOP_COMPASS_SUBSCRIPTION_PLAN_ID=
WHOP_RESONANCE_WEEK_1_PRODUCT_ID=
WHOP_RESONANCE_WEEK_2_PRODUCT_ID=
WHOP_RESONANCE_WEEK_3_PRODUCT_ID=
WHOP_RESONANCE_WEEK_4_PRODUCT_ID=
WHOP_RESONANCE_WEEK_5_PRODUCT_ID=
WHOP_RESONANCE_WEEK_6_PRODUCT_ID=
WHOP_RESONANCE_WEEK_7_PRODUCT_ID=
WHOP_RESONANCE_WEEK_8_PRODUCT_ID=
WHOP_RESONANCE_WEEK_9_PRODUCT_ID=
WHOP_RESONANCE_WEEK_10_PRODUCT_ID=
WHOP_CURRENT_PRODUCT_ID=

# ── Resonance visit-credit checkout (staged; legacy remains the default) ──────
# Apply migrations before enabling storage. Turning off CHECKOUT stops new
# package charges while ENABLED keeps purchased visit balances usable.
RESONANCE_VISITS_ENABLED=false
RESONANCE_VISITS_CHECKOUT_ENABLED=false
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_RESONANCE_VISITS_PRODUCT_ID=
# One-time, fixed USD plans under the visit product; no trial, recurring
# billing, adaptive pricing, expiry at purchase, or undisclosed buyer fees.
# Exact amounts are owned by src/lib/oremea/pricing.ts, not these variable names.
WHOP_RESONANCE_VISITS_1_PLAN_ID=
WHOP_RESONANCE_VISITS_2_PLAN_ID=
WHOP_RESONANCE_VISITS_3_PLAN_ID=
WHOP_RESONANCE_VISITS_4_PLAN_ID=
WHOP_RESONANCE_VISITS_5_PLAN_ID=
WHOP_RESONANCE_VISITS_6_PLAN_ID=
WHOP_RESONANCE_VISITS_7_PLAN_ID=
WHOP_RESONANCE_VISITS_8_PLAN_ID=
WHOP_RESONANCE_COMPLETE_FROM_1_PLAN_ID=
WHOP_RESONANCE_COMPLETE_FROM_3_PLAN_ID=
WHOP_RESONANCE_COMPLETE_FROM_4_PLAN_ID=
# Webhook subscriptions: payment.succeeded, payment.failed, payment.canceled,
# refund.created, refund.updated. Test the current v1 signed payloads before
# enabling sales. Account permissions and tax/fee/3DS behavior are launch gates.

# Optional owner overrides for internal testing. Buyers still require verified
# Whop access for the product they enter.
RECOGNITION_OWNER_USER_ID=
COMPASS_OWNER_USER_ID=

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Free Oremea live session ─────────────────────────────────────────────────
# Human-readable start only. Do not publish or promise a duration.
OREMEA_PARTY_START_LABEL=
NEXT_PUBLIC_OREMEA_PARTY_ORIGIN=https://www.oremea.com
